rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasUserDoc() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // 旧方式（admins/{uid}）も admin として扱う
    function isAdmin() {
      return signedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (hasUserDoc() && userDoc().role == 'admin')
      );
    }

    // admin または 幹部
    function isStaff() {
      return isAdmin() || (signedIn() && hasUserDoc() && userDoc().role == 'executive');
    }

    // 旧admins管理（読み取りのみ。書き込みはコンソールから）
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // ユーザープロフィール
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());

      // 新規登録: 自分のドキュメントのみ、権限は必ず user
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['fullName', 'email', 'username', 'role', 'createdAt'])
        && request.resource.data.role == 'user'
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() > 0
        && request.resource.data.fullName.size() <= 30
        && request.resource.data.email is string
        && request.resource.data.username is string
        && request.resource.data.username.matches('^[a-z0-9_]{3,20}$');

      // 権限の変更は admin のみ
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ユーザーネーム重複防止（新規作成のみ・上書き不可）
    match /usernames/{username} {
      // get（1件取得）のみ未ログインでも可: ログイン時にユーザー名からメールを引くため。
      // list（一覧取得）はログイン済みのみ。
      allow get: if true;
      allow list: if signedIn();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && username.matches('^[a-z0-9_]{3,20}$');
      allow update: if false;
      allow delete: if isAdmin();
    }

    // 自分のフルネーム（アプリ側のnormNameで正規化済みの値）
    function myName() {
      return userDoc().fullName;
    }

    // シフト: 閲覧はログイン済み。書き込みは形式を検証し、
    // 一般ユーザーは「自分の名前」を removed に出し入れする変更のみ許可。削除は staff のみ。
    // （added 内の名前までは Rules で検証できないため、そこはアプリ側の制限に依存）
    function validShift() {
      let d = request.resource.data;
      return d.keys().hasOnly(['removed', 'added'])
        && d.removed is list && d.removed.size() <= 50
        && d.added is list && d.added.size() <= 50;
    }

    function shiftRemovedChangeIsMine() {
      let before = resource == null ? [] : resource.data.get('removed', []);
      let after = request.resource.data.removed;
      return after.toSet().difference(before.toSet()).hasOnly([myName()])
        && before.toSet().difference(after.toSet()).hasOnly([myName()]);
    }

    match /shifts/{date} {
      allow read: if signedIn();
      allow create, update: if signedIn() && hasUserDoc()
        && date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && validShift()
        && (isStaff() || shiftRemovedChangeIsMine());
      allow delete: if isStaff();
    }

    // 振替回数: 一般ユーザーは自分の名前のカウントのみ変更可。削除は staff のみ。
    function validCounts() {
      let d = request.resource.data;
      return d.keys().hasOnly(['c']) && d.c is map;
    }

    function countsChangeIsMine() {
      let before = resource == null ? {} : resource.data.get('c', {});
      return request.resource.data.c.diff(before).affectedKeys().hasOnly([myName()]);
    }

    match /counts/{day} {
      allow read: if signedIn();
      allow create, update: if signedIn() && hasUserDoc()
        && validCounts()
        && (isStaff() || countsChangeIsMine());
      allow delete: if isStaff();
    }

    // 固定メンバー設定
    match /config/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // 特例申請: 作成は本人、閲覧・承認・却下は admin / 幹部
    match /requests/{id} {
      allow create: if signedIn() && hasUserDoc()
        && id.matches('^[0-9]{10,16}$')
        && request.resource.data.keys().hasOnly(['id', 'name', 'originalDate', 'type', 'reason', 'targetDate', 'createdAt'])
        && request.resource.data.id is number
        && request.resource.data.name == myName()
        && request.resource.data.type in ['absent', 'special_transfer']
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && request.resource.data.reason.size() <= 200
        && request.resource.data.originalDate is string
        && request.resource.data.targetDate is string
        && request.resource.data.createdAt is string;
      allow read, update, delete: if isStaff();
    }
  }
}
